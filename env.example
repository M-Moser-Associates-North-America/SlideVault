# SlideVault environment variables. Placeholders only; never put real values here.
# Copy to .env.local (gitignored) to override defaults on your machine.
# Hosted environments use the platform's deployment-scoped secrets instead (AGENTS.md).
# None of these are exposed to the browser (no NEXT_PUBLIC_ prefix).

# Folder of source .pptx decks the library is built from.
# Optional · server and ingest · default: tests/fixtures (synthetic decks)
# Point at real client decks only for an approved export-quality check, outside the repo.
SLIDEVAULT_LIBRARY_DIR=tests/fixtures

# Folder for derived data: library index and slide previews. Must be gitignored.
# Optional · server and ingest · default: .data
SLIDEVAULT_DATA_DIR=.data

# LibreOffice executable used to render slide previews during ingest.
# Optional · ingest only · default: soffice (from PATH)
# macOS example: /Applications/LibreOffice.app/Contents/MacOS/soffice
SOFFICE=soffice

# Supabase project (Postgres + storage). Created 2026-10-10 under a personal
# account as a pragmatic, reversible choice -- ownership is still an open
# question (D-07) to confirm with M Moser.
# Required · server only · the service role key bypasses RLS, so it must
# never reach the browser and every query using it must check authorization
# in application code (docs/SECURITY_AND_OPERATIONS.md).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DATABASE_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# M Moser's Supabase project (FD-12). Alina gives each developer a personal database login
# and a separate Storage account; copy yours into .env.local. Never commit real values.
# Required for uploads, search over uploaded decks and their downloads · server only.
SV_DB_HOST=your-pooler-host.pooler.supabase.com
SV_DB_PORT=5432
SV_DB_NAME=postgres
SV_DB_USER=your-personal-db-login
SV_DB_PASSWORD=replace-me
SV_DB_SCHEMA=slidevault
# Optional: path to the project's CA certificate, so the database certificate is fully verified.
SV_DB_CA_FILE=
SV_SUPABASE_URL=https://your-project-ref.supabase.co
SV_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SV_STORAGE_EMAIL=you@example.com
SV_STORAGE_PASSWORD=replace-me
SV_STORAGE_BUCKET=your-private-bucket
SV_STORAGE_PREFIX=your-upload-folder

# Quick AI search reader (docs/DECISIONS.md FD-17). Optional · server only.
# none (default): rules only, nothing leaves the server.
# openai-compatible: any Chat Completions endpoint, e.g. a local Ollama running Qwen3
#   (SV_AI_BASE_URL=http://localhost:11434/v1, SV_AI_MODEL=qwen3:8b, no key needed)
#   or OpenAI (SV_AI_BASE_URL=https://api.openai.com/v1 plus a model and key).
# Send real M Moser content to a hosted provider only once M Moser has approved it (D-12).
SV_AI_PROVIDER=none
SV_AI_BASE_URL=
SV_AI_MODEL=
SV_AI_API_KEY=
# Optional: reasoning_effort sent to reasoning models. For local Qwen3 use none (about 1s instead of
# 20-50s); leave empty for models that don't take it.
SV_AI_REASONING_EFFORT=
# Optional: how long to wait for the reader before using the rules-only stand-in (ms, 1000-60000).
SV_AI_TIMEOUT_MS=15000
